# Database
POSTGRES_USER=uzum
POSTGRES_PASSWORD=change_me_strong_password_32chars
POSTGRES_DB=uzum_dashboard
DATABASE_URL=postgresql://uzum:change_me_strong_password_32chars@localhost:5432/uzum_dashboard

# Smartup integration
SMARTUP_BASE_URL=https://smartup.online
SMARTUP_USERNAME=
SMARTUP_PASSWORD=
SMARTUP_PROJECT_CODE=trade
SMARTUP_FILIAL_ID=
SMARTUP_FILIAL_CODE=
SMARTUP_WAREHOUSE_CODE=
SMARTUP_PRICE_TYPE_CODE=
SMARTUP_ROOM_CODE=
SMARTUP_ROBOT_CODE=
SMARTUP_SALES_MANAGER_CODE=
SMARTUP_PERSON_CODE=
SMARTUP_OWNER_PERSON_CODE=
SMARTUP_CURRENCY_CODE=840
SMARTUP_SELF_SHIPMENT=Y
SMARTUP_ORDER_STATUS="B#N"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_DB=0

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=change_me_jwt_secret_minimum_64_characters_long_for_security
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=365d
JWT_REFRESH_SECRET=change_me_refresh_secret_different_from_jwt_secret_64chars
OTP_SECRET=change_me_otp_hmac_secret_minimum_64_characters

# Encryption — MUST be exactly 32 characters for AES-256
ENCRYPTION_SECRET=change_me_32_char_encryption_key!

# CORS
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
